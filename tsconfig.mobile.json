{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "rewriteRelativeImportExtensions": true,
    "outDir": "dist-mobile",
